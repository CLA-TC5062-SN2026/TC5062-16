# .env NUNCA se sube al repositorio (ver .gitignore).

# Django
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-generada-con-get_random_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (PostgreSQL 16, esquema_bd.sql ya importado)
DB_NAME=laundrydesk
DB_USER=laundrydesk
DB_PASSWORD=cambia-esta-contrasena
DB_HOST=localhost
DB_PORT=5433

# Si usas el contenedor de Docker de S05-S06-A1 (laundrydesk-db),
# los valores son DB_USER=postgres, DB_PASSWORD=contrasena y
# DB_PORT=5432. Ajusta según tu instalación de PostgreSQL.

# Compatibilidad de transición desde S05-S06-A1. Solo se usa para convertir
# la fila admin_temporal en la cuenta real durante el primer /auth/register.
# Los CRUD protegidos usan request.user obtenido del JWT.
ADMIN_ID_TEMPORAL=00000000-0000-0000-0000-000000000001

# JWT
JWT_SECRET=reemplaza-por-un-secreto-largo-y-aleatorio
JWT_EXPIRATION=3600

# CORS: orígenes del frontend permitidos para llamar a esta API, separados
# por coma. http://localhost:5173 es el puerto por defecto de Vite en
# desarrollo. Si pruebas desde un Codespace, agrega aquí la URL pública que
# asigna a tu puerto de Vite (termina en .app.github.dev), además de la
# local; ambas pueden ir juntas separadas por coma.
CORS_ALLOWED_ORIGINS=http://localhost:5173
